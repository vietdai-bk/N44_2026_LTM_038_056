<mxfile host="drawio"><diagram name="phat_lai_ns3" id="phat_lai_ns3"><mxGraphModel dx="900" dy="860" grid="1" gridSize="10" guides="1" page="1" pageWidth="900" pageHeight="860" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="Lưu đồ phát lại một kế hoạch trong NS-3 (uav-lte)" style="text;align=center;verticalAlign=middle;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontFamily=Helvetica;fontSize=17;fontColor=#14181f;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="5" width="900" height="30" as="geometry"/></mxCell><mxCell id="c4" value="Bắt đầu" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#e5edf8;strokeColor=#1a4d8f;fontFamily=Helvetica;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="330" y="50" width="240" height="45" as="geometry"/></mxCell><mxCell id="c5" value="Đọc kế hoạch uavs.csv, users.csv" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#aeb6c2;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="250" y="120" width="400" height="50" as="geometry"/></mxCell><mxCell id="c6" value="Dựng mạng: remote host, EPC (PGW, SGW, MME), eNB, UE&lt;br&gt;&lt;font style='font-size:11px'&gt;link=ideal: thay EPC/LTE bằng liên kết điểm-điểm&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#aeb6c2;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="250" y="195" width="400" height="70" as="geometry"/></mxCell><mxCell id="c7" value="Đặt điểm mốc vị trí eNB, UE; attach UE theo khe 0" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#aeb6c2;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="250" y="290" width="400" height="50" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Đầu khe n&lt;/b&gt;&lt;br&gt;đặt tốc độ phát UDP từng user&lt;br&gt;handover X2 nếu kế hoạch đổi UAV&lt;br&gt;đặt trọng số WPF b&lt;sub&gt;k&lt;/