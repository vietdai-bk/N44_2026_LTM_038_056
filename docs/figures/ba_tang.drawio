<mxfile host="drawio"><diagram name="ba_tang" id="ba_tang"><mxGraphModel dx="1150" dy="380" grid="1" gridSize="10" guides="1" page="1" pageWidth="1150" pageHeight="380" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="Kiểm chứng ba tầng: cùng một kế hoạch chạy ở ba mức" style="text;align=center;verticalAlign=middle;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontFamily=Helvetica;fontSize=17;fontColor=#14181f;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="5" width="1150" height="30" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Tầng 1: Lý thuyết (như bài báo)&lt;/b&gt;&lt;br&gt;&lt;br&gt;Kênh Al-Hourani, Shannon có nhiễu&lt;br&gt;Hàng đợi theo khe, độ trễ FIFO chính xác&lt;br&gt;Mất gói = 1 − nhận/gửi" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e5edf8;strokeColor=#1a4d8f;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="30" y="70" width="300" height="170" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Tầng 2: NS-3 liên kết lý tưởng&lt;/b&gt;&lt;br&gt;&lt;br&gt;Gói UDP thật, mỗi user một liên kết&lt;br&gt;Tốc độ liên kết = rate lý thuyết từng khe&lt;br&gt;Bộ đệm 1 MiB" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff1dc;strokeColor=#eda100;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="425" y="70" width="300" height="170" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Tầng 3: NS-3 LTE&lt;/b&gt;&lt;br&gt;&lt;br&gt;eNB bay, UE, EPC, handover X2&lt;br&gt;Scheduler PF / WPF, HARQ, AMC&lt;br&gt;Đo throughput, độ trễ, mất gói" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e2f3e8;strokeColor=#157a3a;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="820" y="70" width="300" height="170" as="geometry"/></mxCell><mxCell id="c7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#157a3a;strokeWidth=2.5;endArrow=block;fontFamily=Helvetica;fontSize=12;fontColor=#14181f;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#d01010;strokeWidth=2.5;endArrow=block;fontFamily=Helvetica;fontSize=12;fontColor=#14181f;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c9" value="khớp&lt;br&gt;&amp;lt; 1%" style="text;align=center;verticalAlign=middle;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontFamily=Helvetica;fontSize=12;fontColor=#157a3a;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="330" y="95" width="95" height="50" as="geometry"/></mxCell><mxCell id="c10" value="chênh lệch&lt;br&gt;do giao thức&lt;br&gt;LTE" style="text;align=center;verticalAlign=middle;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontFamily=Helvetica;fontSize=12;fontColor=#d01010;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="725" y="85" width="95" height="60" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Ý nghĩa:&lt;/b&gt; tầng giữa tách lỗi của mô hình khỏi ảnh hưởng của giao thức. Tầng 1 khớp tầng 2 dưới 1% → mô hình hàng đợi đúng; khoảng cách tầng 2 → 3 được giải thích bằng ba nguyên nhân (công thức 3GPP, trần SE, AMC) và thu về ±3% bằng hai hằng số đo từ NS-3 (α = 0.401, SE&lt;sub&gt;max&lt;/sub&gt; = 3.514)." style="rounded=1;arcSize=6;align=left;spacingLeft=12;whiteSpace=wrap;html=1;fillColor=#f6f7f9;strokeColor=#d3d8e0;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="30" y="270" width="1090" height="85" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>