<mxfile host="drawio"><diagram name="thoi_gian_thuc" id="thoi_gian_thuc"><mxGraphModel dx="1150" dy="460" grid="1" gridSize="10" guides="1" page="1" pageWidth="1150" pageHeight="460" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="Hệ thống điều khiển thời gian thực" style="text;align=center;verticalAlign=middle;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontFamily=Helvetica;fontSize=17;fontColor=#14181f;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="5" width="1150" height="30" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Trình duyệt (dashboard)&lt;/b&gt;&lt;br&gt;&lt;br&gt;Vẽ 60 Hz, nội suy giữa hai khe&lt;br&gt;Bản đồ, chỉ số, nhóm user, biểu đồ&lt;br&gt;Lái tay W A S D, nhấp để bay tới&lt;br&gt;Đổi 13 tham số, nút Ghi &amp;amp; đo" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e5edf8;strokeColor=#1a4d8f;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="30" y="70" width="300" height="170" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Server asyncio (live.py)&lt;/b&gt;&lt;br&gt;&lt;br&gt;Mỗi khe 0.25 s (tăng tốc 0.5–4×)&lt;br&gt;Thuật toán → quyết định → mô hình&lt;br&gt;Tốc độ Shannon và LTE dự đoán&lt;br&gt;Kiểm tra lệnh, an toàn khi mất kết nối" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff1dc;strokeColor=#eda100;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="425" y="70" width="300" height="170" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Gazebo&lt;/b&gt;&lt;br&gt;UAV quadrotor; người áo màu UAV phục vụ&lt;br&gt;vòng vàng important, vòng đỏ critical" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e2f3e8;strokeColor=#157a3a;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="820" y="50" width="300" height="110" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;NS-3 (luồng riêng)&lt;/b&gt;&lt;br&gt;phát lại đoạn đã ghi, trả số đo về web" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e2f3e8;strokeColor=#157a3a;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="820" y="179" width="300" height="90" as="geometry"/></mxCell><mxCell id="c8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4d5766;strokeWidth=2;endArrow=block;fontFamily=Helvetica;fontSize=12;fontColor=#14181f;labelBackgroundColor=#ffffff;startArrow=block;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4d5766;strokeWidth=1.5;endArrow=block;fontFamily=Helvetica;fontSize=12;fontColor=#14181f;labelBackgroundColor=#ffffff;exitX=1;exitY=0.206;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4d5766;strokeWidth=1.5;endArrow=block;fontFamily=Helvetica;fontSize=12;fontColor=#14181f;labelBackgroundColor=#ffffff;exitX=1;exitY=0.906;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c5" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c11" value="WebSocket&lt;br&gt;JSON" style="text;align=center;verticalAlign=middle;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontFamily=Helvetica;fontSize=12;fontColor=#14181f;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="330" y="95" width="95" height="55" as="geometry"/></mxCell><mxCell id="c12" value="pose 20 Hz" style="text;align=center;verticalAlign=middle;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontFamily=Helvetica;fontSize=11;fontColor=#14181f;" vertex="1" parent="1"><mxGeometry x="728" y="84" width="90" height="20" as="geometry"/></mxCell><mxCell id="c13" value="kế hoạch" style="text;align=center;verticalAlign=middle;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontFamily=Helvetica;fontSize=11;fontColor=#14181f;" vertex="1" parent="1"><mxGeometry x="728" y="201" width="90" height="20" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;Luồng một khe:&lt;/b&gt; (1) nhận lệnh lái tay / bay tới / đổi tham số → (2) thuật toán ra quyết định, UAV lái tay lấy vận tốc từ web → (3) mô hình tính SINR, tốc độ, hàng đợi → (4) gửi trạng thái cho web, gửi vị trí nội suy cho Gazebo → (5) nếu đang ghi, lưu kế hoạch; đủ khe thì chạy NS-3 trong luồng riêng và trả bảng mô hình so với NS-3 về web." style="rounded=1;arcSize=6;align=left;spacingLeft=12;whiteSpace=wrap;html=1;fillColor=#f6f7f9;strokeColor=#d3d8e0;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="30" y="300" width="1090" height="120" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>