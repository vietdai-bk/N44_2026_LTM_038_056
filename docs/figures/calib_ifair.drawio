<mxfile host="drawio"><diagram name="calib_ifair" id="calib_ifair"><mxGraphModel dx="900" dy="900" grid="1" gridSize="10" guides="1" page="1" pageWidth="900" pageHeight="900" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="Lưu đồ thuật toán đề xuất calib-ifair (mỗi khe)" style="text;align=center;verticalAlign=middle;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontFamily=Helvetica;fontSize=17;fontColor=#14181f;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="5" width="900" height="30" as="geometry"/></mxCell><mxCell id="c4" value="Bắt đầu khe n" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#e5edf8;strokeColor=#1a4d8f;fontFamily=Helvetica;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="330" y="50" width="240" height="45" as="geometry"/></mxCell><mxCell id="c5" value="Nối mỗi user với UAV có độ lợi lớn nhất (a&lt;sub&gt;k&lt;/sub&gt;)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#aeb6c2;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="270" y="120" width="360" height="55" as="geometry"/></mxCell><mxCell id="c6" value="Tính SINR có nhiễu từ mọi UAV đang phục vụ&lt;br&gt;ŜE&lt;sub&gt;k&lt;/sub&gt; = min(0.401·log₂(1+SINR), 3.514)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#aeb6c2;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="270" y="200" width="360" height="70" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;ifair:&lt;/b&gt; b&lt;sub&gt;k&lt;/sub&gt; ∝ w&lt;sub&gt;k&lt;/sub&gt; / max(ŜE&lt;sub&gt;k&lt;/sub&gt;, 0.05)&lt;br&gt;(w = 1/2/4 theo nhóm)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff1dc;strokeColor=#eda100;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="270" y="295" width="360" height="70" as="geometry"/></mxCell><mxCell id="c8" value="UAV j còn cách tâm cụm k-means quá một bước?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#aeb6c2;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="295" y="395" width="310" height="90" as="geometry"/></mxCell><mxCell id="c9" value="Bay thẳng về tâm cụm" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#aeb6c2;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="660" y="410" width="200" height="60" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;calib:&lt;/b&gt; thử đứng yên + 8 hướng × 2 cỡ bước&lt;br&gt;tính U = Σ w&lt;sub&gt;k&lt;/sub&gt; log(r̂&lt;sub&gt;k&lt;/sub&gt; + r&lt;sub&gt;0&lt;/sub&gt;)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff1dc;strokeColor=#eda100;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="270" y="515" width="360" height="80" as="geometry"/></mxCell><mxCell id="c11" value="Chọn nước đi tăng U nhiều nhất,&lt;br&gt;không làm UAV nào mất hết user" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#aeb6c2;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="270" y="620" width="360" height="60" as="geometry"/></mxCell><mxCell id="c12" value="Còn UAV chưa xét?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#aeb6c2;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="295" y="705" width="310" height="80" as="geometry"/></mxCell><mxCell id="c13" value="Gửi quyết định: b&lt;sub&gt;k&lt;/sub&gt; → scheduler WPF (MAC), v&lt;sub&gt;m&lt;/sub&gt; → UAV" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#e2f3e8;strokeColor=#157a3a;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="270" y="815" width="360" height="55" as="geometry"/></mxCell><mxCell id="c14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4d5766;strokeWidth=1.5;endArrow=block;fontFamily=Helvetica;fontSize=12;fontColor=#14181f;labelBackgroundColor=#ffffff;" ed