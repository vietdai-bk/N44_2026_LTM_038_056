;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c6" target="c19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c21" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1baf7a;strokeColor=#14181f;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="840" y="400" width="34" height="34" as="geometry"/></mxCell><mxCell id="c22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1baf7a;strokeWidth=1.2;endArrow=none;fontFamily=Helvetica;fontSize=12;fontColor=#14181f;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c6" target="c21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c23" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1baf7a;strokeColor=#14181f;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="930" y="350" width="34" height="34" as="geometry"/></mxCell><mxCell id="c24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1baf7a;strokeWidth=1.2;endArrow=none;fontFamily=Helvetica;fontSize=12;fontColor=#14181f;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c6" target="c23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c25" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1baf7a;strokeColor=#14181f;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1000" y="420" width="34" height="34" as="geometry"/></mxCell><mxCell id="c26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1baf7a;strokeWidth=1.2;endArrow=none;fontFamily=Helvetica;fontSize=12;fontColor=#14181f;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c6" target="c25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c27" value="" style="rounded=1;html=1;strokeColor=#d01010;strokeWidth=1.8;endArrow=block;fontFamily=Helvetica;fontSize=12;fontColor=#14181f;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="c4" target="c17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c28" value="nhiễu đồng kênh&lt;br&gt;tới user của UAV 1" style="text;align=center;verticalAlign=middle;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontFamily=Helvetica;fontSize=12;fontColor=#d01010;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="560" y="175" width="190" height="40" as="geometry"/></mxCell><mxCell id="c29" value="" style="rounded=1;html=1;strokeColor=#d01010;strokeWidth=1.8;endArrow=block;fontFamily=Helvetica;fontSize=12;fontColor=#14181f;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="c6" target="c17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c30" value="&lt;b&gt;Mỗi khe Δt, thuật toán quyết định:&lt;/b&gt; user nối UAV nào (a&lt;sub&gt;k&lt;/sub&gt;), chia băng thông (b&lt;sub&gt;k&lt;/sub&gt;), công suất (p&lt;sub&gt;k&lt;/sub&gt;), vận tốc UAV (v&lt;sub&gt;m&lt;/sub&gt;).&lt;br&gt;&lt;b&gt;Ràng buộc mỗi UAV:&lt;/b&gt; Σb&lt;sub&gt;k&lt;/sub&gt; ≤ 1 (băng B = 10 MHz), Σp&lt;sub&gt;k&lt;/sub&gt; ≤ P&lt;sub&gt;max&lt;/sub&gt;, ‖v&lt;sub&gt;m&lt;/sub&gt;‖ ≤ V&lt;sub&gt;max&lt;/sub&gt;, trong vùng L×L. Các UAV dùng chung băng nên nhiễu nhau.&lt;br&gt;&lt;b&gt;Nhóm user:&lt;/b&gt; ● normal (w = 1, ≥ 0.5 Mbps) &amp;nbsp; ■ important (w = 2, ≥ 1 Mbps) &amp;nbsp; ◆ critical (w = 4, ≥ 2 Mbps). &lt;b&gt;Mục tiêu:&lt;/b&gt; max Σ w&lt;sub&gt;k&lt;/sub&gt; log(r&lt;sub&gt;k&lt;/sub&gt; + r&lt;sub&gt;0&lt;/sub&gt;)" style="rounded=1;arcSize=4;align=left;spacingLeft=12;whiteSpace=wrap;html=1;fillColor=#f6f7f9;strokeColor=#d3d8e0;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="60" y="470" width="990" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>